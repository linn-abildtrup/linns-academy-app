rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		// Admin-emails. Skal matche listen i src/lib/admin.ts.
		// Tilføj her hvis flere skal kunne redigere indhold fra UI'et.
		function isAdmin() {
			return request.auth != null
				&& request.auth.token.email in [
					'linnabildtrup00@gmail.com'
				];
		}

		// Bruger-dokument:
		//   - Ejeren kan læse og skrive sit eget
		//   - Admin kan læse alle brugere (til admin-overblik i Abonnenter-siden)
		match /users/{uid} {
			allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
			allow write: if request.auth != null && request.auth.uid == uid;
			// Admin må OPDATERE udvalgte felter på andre brugere — bruges fra
			// admin-siden /admin/testere til at tildele test-adgang. Begrænset
			// til de specifikke felter for sikkerhed; admin kan ikke overskrive
			// brugerens kerne-data (state, accessLevel, dagligeMaal osv.) ad
			// denne vej.
			allow update: if request.auth != null
				&& isAdmin()
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'testerFeatures'
				]);

			// Bruger-produkter (køb, fremgang, valg): kun egen bruger
			match /products/{productId} {
				allow read: if request.auth != null && request.auth.uid == uid;
				// A-Z #8 (5. juni 2026): begraens egneVaner-listen til max 3
				// elementer. UI'en haandhaever det allerede, men en kunde med
				// DevTools kunne ellers skrive vilkaarligt mange — og kunne
				// dermed forurene sin daglige tjek-liste med fx 10+ vaner.
				// Reglen accepterer create/update hvis enten egneVaner ikke
				// findes paa request.resource eller har <= 3 elementer.
				allow write: if request.auth != null
					&& request.auth.uid == uid
					&& (!('egneVaner' in request.resource.data)
						|| request.resource.data.egneVaner.size() <= 3);

				// Vanedage på et produkt: kun egen bruger
				match /vanedage/{dagId} {
					allow read, write: if request.auth != null && request.auth.uid == uid;
				}
			}

			// Pause-state for igangværende træning: kun egen bruger
			match /pauses/{pauseId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Dagbog — gemte måltider fra 30-30-3-beregneren: kun egen bruger
			match /maaltider/{mealId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Favoritmåltider — skabeloner til hurtig genbrug: kun egen bruger
			match /favoritmaaltider/{favId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Egne fødevarer — kundens private fødevarer (fra scanner eller
			// manuelt tilføjet). Kun egen bruger har read/write.
			match /customFodevarer/{foodId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Vanedage på userProduct: kun egen bruger (samme regel som pauses)
			// Stien er users/{uid}/products/{productId}/vanedage/{dagId} så
			// reglen ligger på products-niveau længere nede.

			// Admin-klient-mode: når Linn bruger 'Skift til klient'-knappen
			// gemmes klient-test-data under users/{uid}/adminKlient/{forlobId}/...
			// Det er stadig hendes egne data, så samme regel: kun ejeren kan
			// læse/skrive. Wildcard {document=**} dækker alle nestede paths.
			match /adminKlient/{forlobId}/{document=**} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Abo-vanetracker — brugerens valgte vaner (single doc 'aktiv')
			match /aboVaneOpsaetning/{docId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Abo-vanetracker — daglige svar pr dato (YYYY-MM-DD som doc-id)
			match /aboVanedage/{dato} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Abo-mikrotræning — brugerens fremgang (single doc 'aktiv')
			match /aboMikrotraeningFremgang/{docId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Abo-mikrotræning — historik pr dato (YYYY-MM-DD som doc-id)
			match /aboMikrotraeningTraeninger/{dato} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Linn AI — brugerens chat-samtaler (premium-feature)
			match /linnAiSamtaler/{samtaleId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Linn AI — daglig query-quota (rate-limit-tæller)
			match /linnAiQuotaer/{dato} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Private opskrifter — klientens egne opskrifter med makro fra AI-vision
			match /privateOpskrifter/{opskriftId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Mine programmer — kundens egne træningsprogrammer bygget med custom-builder
			match /mineProgrammer/{programId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Spil-pause — gemt state så kunden kan genoptage en træning hvor hun slap
			match /spilPauser/{pauseId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Program-fremgang — historik over gennemførte træninger pr program
			match /programFremgang/{fremgangId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Lektion-noter — kundens egne refleksioner pr lektion i et forløb
			match /lektionNoter/{noterId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Træning-historik — én entry pr gennemført træning, gemt pr dato
			match /traeningHistorik/{entryId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Fremgang i 3.0's træningsprogrammer — ét dokument pr program.
			// Kun kunden selv. Admin læser den ikke: admin-opslaget svarer på
			// hvad hun MÅ se, ikke hvor langt hun er nået.
			match /traeningFremgang3/{programId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Gemt plads midt i en træning, så hun kan fortsætte hvor hun
			// slap. Ét dokument pr program. Kun kunden selv.
			match /traeningPlads3/{programId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// Programmerne kunden selv har bygget i 3.0. Ét dokument pr
			// program, med træningerne i. Kun hun må skrive i dem, de er
			// hendes. Admin må LÆSE dem, så Linn kan se dem i kunde-opslaget
			// og hjælpe hende hvis hun spørger.
			match /mineTraeninger3/{programId} {
				allow read: if request.auth != null && (isAdmin() || request.auth.uid == uid);
				allow write: if request.auth != null && request.auth.uid == uid;
			}

			// Klaret i den nye app (3.0) — hvilke lektioner kunden har
			// markeret som taget. Ét dokument pr lektion, doc-id er
			// lektionens id. Kun egen bruger, samme regel som alt andet
			// herinde. Bruges ikke af den nuvaerende app.
			match /nyKlaret/{lektionId} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}

			// MRS-scorer — udfyldte symptomtjeklister (baseline/midtvejs/afslutning).
			// Update er stadig spærret (data er forskningsdata der ikke må ændres
			// efter udfyldelse). Delete er åbnet for ejeren så klienten kan
			// fortryde en lige-udfyldt symptomcheck — UI'en viser dog kun slet
			// på den nyeste udfyldelse for at bevare historik til sammenligning.
			match /mrs_scores/{scoreId} {
				allow read: if request.auth != null && request.auth.uid == uid;
				allow create: if request.auth != null && request.auth.uid == uid;
				allow update: if false;
				allow delete: if request.auth != null && request.auth.uid == uid;
			}
		}

		// Øvelsesbibliotek: alle autentificerede kan læse, kun admin kan skrive
		match /exercises/{exerciseId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Træningsprogrammer + deres dage: alle autentificerede kan læse, kun admin kan skrive
		match /trainingPrograms/{programId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();

			match /days/{dayId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}
		}

		// Træning i 3.0 (bid 1, 15. august 2026). Programmerne ligger for sig
		// selv og er uafhængige af forløb og abonnement. Kun 3.0 læser her,
		// den gamle app kender dem ikke.
		//
		// Samme adgang som de gamle trainingPrograms ovenfor: alle der er
		// logget ind må læse, kun admin må skrive. Kunden skal kunne læse sit
		// eget program, og hvem der har adgang til hvad afgøres af
		// tildelingerne, som kommer i næste bid.
		match /traeningKategorier3/{kategoriId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		match /traeningsprogrammer3/{programId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();

			match /dage/{dagId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}
		}

		// Tildelinger af træning (3.0). Hvem har fået hvilket program, og
		// hvornår det gælder. Kun admin må skrive.
		//
		// LÆSNINGEN ER DELT I TO, og det er med vilje (bid 3, 15. august):
		//
		//   - Rækker til et hold, til medlemmer og til alle indeholder ingen
		//     personoplysninger. Dem må enhver indlogget kunde læse, for hun
		//     skal kunne se hvilke programmer hun har fået gennem sit hold.
		//   - En række til ÉN person indeholder hendes navn. Den må kun hun
		//     selv læse, og reglen kræver at forespørgslen er snævret ind til
		//     hendes eget uid.
		//
		// Et enkelt kald efter hele samlingen bliver derfor afvist for alle
		// andre end admin, og det er meningen: kunder skal ikke kunne læse
		// hinandens navne. Se hentMineTildelinger3 for de to forespørgsler.
		match /traeningTildelinger3/{tildelingId} {
			allow read: if isAdmin()
				|| (request.auth != null
					&& resource.data.modtagerType in ['hold', 'medlemmer', 'alle'])
				|| (request.auth != null && resource.data.modtagerId == request.auth.uid);
			allow write: if isAdmin();
		}

		// Challenges der ligger for sig selv og bliver tildelt (3.0).
		// De gamle, der hører til ét forløb, ligger fortsat under
		// forlob/{id}/challenges og har deres egen regel længere nede.
		//
		// Selve challengen: alle indloggede kan læse, kun admin kan skrive.
		// Indtastninger: hver kunde skriver kun sin egen, men alle kan læse
		// dem, fordi stillingen skal kunne vise de øverste.
		match /challenges/{challengeId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();

			match /indtastninger/{uid} {
				allow read: if request.auth != null;
				allow write: if request.auth != null && request.auth.uid == uid;
			}
		}

		// Produkter (Kickstart osv.): alle autentificerede kan læse, kun admin kan skrive
		match /products/{productId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Fødevaredatabase (840+ items): alle autentificerede kan læse,
		// kun admin kan skrive. Klienten cacher hele databasen ved første load.
		match /fodevarer/{fodevareId} {
			allow read: if request.auth != null;
			// Admin må alt
			allow write: if isAdmin();
			// Logget-ind brugere må oprette community-fødevarer (cf_-prefix)
			// så længe addedBy matcher dem selv, kilde er 'community', og
			// scanner-brugeren er i okBy som første stem.
			allow create: if request.auth != null
				&& fodevareId.matches('cf_.*')
				&& request.resource.data.kilde == 'community'
				&& request.resource.data.addedBy == request.auth.uid
				&& request.resource.data.okBy is list
				&& request.resource.data.okBy.size() == 1
				&& request.resource.data.okBy[0] == request.auth.uid;
			// Logget-ind brugere må stemme på community-fødevarer ved at
			// opdatere okBy / ejBy / verificeret. Andre felter må ikke ændres.
			allow update: if request.auth != null
				&& fodevareId.matches('cf_.*')
				&& resource.data.kilde == 'community'
				&& request.resource.data.diff(resource.data).affectedKeys()
					.hasOnly(['okBy', 'ejBy', 'verificeret']);
		}

		// Ingrediens-koblingen. Kortet fra kernenavn til foedevare, som
		// regnemaskinen bruger til at regne makro ud af maengderne.
		// Etape 3, se SPEC-3.0.md 26.19.
		//
		// Alle indloggede maa laese, for kunden skal kunne se makroen paa
		// en opskrift. Kun admin maa skrive.
		match /ingrediensKobling/{dokId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Opskrifter: alle autentificerede kan læse, kun admin kan skrive.
		// Undtagelse: klienter må opdatere rating-aggregatet (ratingSum,
		// ratingCount, ratingAvg) når de stemmer.
		match /opskrifter/{opskriftId} {
			allow read: if request.auth != null;
			allow create, delete: if isAdmin();
			allow update: if isAdmin()
				|| (request.auth != null
					&& request.resource.data.diff(resource.data).affectedKeys()
						.hasOnly(['ratingSum', 'ratingCount', 'ratingAvg']));

			// Hver klients egen rating-doc — kun hun selv må læse/skrive den.
			match /ratings/{uid} {
				allow read, write: if request.auth != null && request.auth.uid == uid;
			}
		}

		// Forløb (kohorter med startdato + whitelist): alle autentificerede kan læse,
		// kun admin kan skrive. Klienten har brug for at læse for at vise startdato.
		match /forlob/{forlobId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();

			// Vaneprogram pr forløb: alle autentificerede kan læse (klienten skal
			// se spørgsmålene), kun admin kan skrive.
			match /vaneprogram/{dagId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Forløbsdage pr forløb (lektioner + note fra Linn pr dagNummer):
			// alle autentificerede kan læse, kun admin kan skrive.
			match /forlobsdage/{dagId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Challenge pr forløb (fx frugt/grønt-challenge): alle autentificerede
			// kan læse, kun admin kan skrive selve challenge-doc. Hver klient kan
			// læse alle indtastninger (til stillingen) men kun skrive sin egen.
			match /challenges/{challengeId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();

				match /indtastninger/{uid} {
					allow read: if request.auth != null;
					allow write: if request.auth != null && request.auth.uid == uid;
				}
			}

			// Mikrotræningsprogrammer pr forløb: program-metadata + dage som
			// subcollection. Alle autentificerede kan læse (klient skal se
			// program og dage), kun admin kan skrive.
			match /mikrotraeningProgrammer/{programId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();

				match /days/{dagId} {
					allow read: if request.auth != null;
					allow write: if isAdmin();
				}
			}

			// Admin-tildelte vaner pr forløb: alle deltagere får dem oveni
			// deres selvvalgte. Alle autentificerede kan læse (kundens side
			// skal merge dem), kun admin kan skrive.
			match /admintildelteVaner/{vaneId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Samlede små skridt pr forløb (nyt samlet system): alle autentificerede
			// kan læse (kundens side skal vise dem), kun admin kan skrive.
			match /smaaSkridt/{skridtId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Bibliotek pr forløb — FAQ-kategorier: alle autentificerede kan læse,
			// kun admin kan skrive. Klient-koden filtrerer på udgivet-flag.
			match /faqKategorier/{kategoriId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Bibliotek pr forløb — FAQ-items: samme regel som kategorier.
			match /faqItems/{itemId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Bibliotek pr forløb — guide-kategorier: samme mønster som FAQ.
			match /guideKategorier/{kategoriId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}

			// Bibliotek pr forløb — guide-items: samme mønster som FAQ.
			match /guideItems/{itemId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}
		}

		// Abo-vanetracker — kurateret vaneliste pr produkttype (basis/premium):
		// alle autentificerede kan læse (klient skal se forslag), kun admin skriver.
		match /aboVaneskabelon/{produktType} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Abo-vanetracker — bonus-pulje pr produkttype:
		// alle autentificerede kan læse, kun admin skriver.
		match /aboBonusPulje/{produktType} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Abo-mikrotræning — program-metadata pr produkttype:
		// alle autentificerede kan læse, kun admin skriver.
		match /aboMikrotraening/{produktType} {
			allow read: if request.auth != null;
			allow write: if isAdmin();

			// Træningsdage 1-14 under hver produkttype
			match /days/{dagId} {
				allow read: if request.auth != null;
				allow write: if isAdmin();
			}
		}

		// Modulbruger-lektioner — daglig lektion på modulbruger-forsiden.
		// Doc-id er YYYY-MM-DD. Alle autentificerede kan læse (vises på
		// forside). Kun admin (Linn) kan oprette/redigere/slette.
		match /modulbrugerLektioner/{dato} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// AI-ratings — brugere rater AI-svar 1-5 stjerner så Linn kan se
		// hvilke svar der er gode/dårlige. Brugere kan oprette/opdatere
		// deres egne ratings (uid skal matche). Admin kan læse alle.
		match /aiRatings/{ratingId} {
			allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
			allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
			allow update: if request.auth != null && resource.data.uid == request.auth.uid;
			allow delete: if isAdmin();
		}

		// Linn AI — videnbase (PDFs, slides, klient-Q&A) som AI'en bruger.
		// Alle autentificerede kan læse (worker'en læser for premium-brugere).
		// Kun admin kan uploade og slette indhold.
		match /linnAiVidenbase/{docId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Linn AI — admin-konfiguration (persona/system-prompt). Læses af
		// worker'en for at hente brugerens custom prompt. Kun admin skriver.
		match /linnAiKonfiguration/{docId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Feature-adgang: admin-styret matrix over hvilke funktioner hver
		// kundetype (kickstart/kropsro/app) har adgang til. Alle
		// autentificerede kan laese, kun admin kan skrive (fra admin-skemaet).
		match /featureAdgang/{docId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Admin-statistik (KPI-snapshots til dashboardet). Genereres af
		// scripts/generer-*-stats.ts via firebase-admin (uden om rules). Kun
		// admin kan laese; ingen klient-skrivning (snapshots laves server-side).
		match /adminStats/{docId} {
			allow read: if isAdmin();
			allow write: if false;
		}

		// Per-kunde cache til hurtig genberegning af dashboard-snapshottet
		// ("Opdater tal"-knappen). Laeses + skrives KUN server-side via service-
		// account (uden om rules). Ingen klient-adgang overhovedet.
		match /mrsCache/{uid} {
			allow read, write: if false;
		}

		// AI-log fra den nye app (3.0). Skrives KUN server-side via
		// service-account (uden om rules). Kun admin kan laese, og ingen
		// klient kan skrive. Bruges af /app/admin/ny-ai.
		match /nyAiLog/{linjeId} {
			allow read: if isAdmin();
			allow write: if false;
		}

		// Kontakten der slukker for AI'en i den nye app. Serveren laeser den
		// ved hvert kald. Kun admin kan taende og slukke.
		match /nyAiKonfiguration/{docId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Klientspørgsmål til Linn:
		//   - Klienter kan oprette deres egne spørgsmål (uid skal matche)
		//   - Klienter kan læse SINE egne spørgsmål (for at se Linns svar)
		//   - Klienter kan IKKE læse andres spørgsmål
		//   - Admin kan læse alle og opdatere status + svar
		match /klientspoergsmaal/{spoergsmaalId} {
			allow read: if isAdmin()
				|| (request.auth != null && resource.data.uid == request.auth.uid);
			allow create: if request.auth != null
				&& request.resource.data.uid == request.auth.uid;
			allow update, delete: if isAdmin();
		}

		// AI svar-udkast historik:
		//   - Indeholder admin's svar + AI-udkast par til stemme-træning
		//   - Worker'en /api/svar-udkast læser via service account (uden om rules)
		//   - Kun admin har adgang via klient-SDK
		match /svarHistorik/{historikId} {
			allow read, write: if isAdmin();
		}

		// Program-tildelinger — admin tildeler træningsprogrammer til kunder
		// eller forløb. Alle autentificerede kan læse (kunde-siden skal kunne
		// tjekke hvilke programmer hun har adgang til), kun admin skriver.
		match /programTildelinger/{tildelingId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Custom-builder-tildelinger — admin giver kunder/forløb adgang til at
		// bygge eget træningsprogram. Samme adgangsmønster som programTildelinger.
		match /customBuilderTildelinger/{tildelingId} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// AllowedEmails (whitelist fra CSV-import):
		//   - Brugeren kan læse SIN egen email-record (til login-flow check)
		//   - Admin kan læse alle og skrive frit (CSV-upload, status-update)
		//   - login-flow har brug for at kunne sætte status='registered' for sin egen
		//
		// A-Z #7 (5. juni 2026): tidligere kunne kunden frit aendre baade status
		// og registreret-tidsstempel — saa hun kunne markere sig selv som
		// "registreret" uden faktisk at have logget ind, eller forfalske
		// tidsstemplet. Nu skal kunden:
		//   - Kun kunne ændre 'status' og 'registreret' (uændret)
		//   - status-overgangen SKAL gaa fra 'invited' til 'registered' (enstrenget)
		//   - hun kan ikke nulstille til 'invited', skifte til andre vaerdier,
		//     eller aendre 'registreret' uden samtidig at sette status='registered'
		match /allowedEmails/{email} {
			allow read: if request.auth != null
				&& (isAdmin() || request.auth.token.email.lower() == email);
			allow update: if request.auth != null
				&& request.auth.token.email.lower() == email
				&& request.resource.data.diff(resource.data).affectedKeys()
					.hasOnly(['status', 'registreret'])
				&& resource.data.status == 'invited'
				&& request.resource.data.status == 'registered';
			allow create, delete: if isAdmin();
			allow write: if isAdmin();
		}
	}
}
