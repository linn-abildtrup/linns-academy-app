rules_version = '2';

// Firebase Storage-rules for Linn's Academy.
// Skal copy-pastes til Firebase Console → Storage → Rules → Publish.
//
// Konvention: alt indhold er læsbart for autentificerede brugere,
// men kun admin må skrive (samme mønster som Firestore-reglerne).

service firebase.storage {
	match /b/{bucket}/o {
		// Admin-emails. Skal matche listen i src/lib/admin.ts og firestore.rules.
		function isAdmin() {
			return request.auth != null
				&& request.auth.token.email in [
					'linnabildtrup00@gmail.com'
				];
		}

		// Øvelses-videoer (træningsmodul)
		match /exercises/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Lyd-filer (træningsmodul + lektioner)
		match /audio/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Forløbs-specifikt indhold (HTML-uploads til lektioner og guides):
		// /forlob/{forlobId}/html/{filename}
		match /forlob/{forlobId}/html/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin()
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('text/html.*');
		}

		// Forløbs-thumbnails — admin-uploaded thumbnail-billeder pr lektion.
		// /forlob/{forlobId}/thumbnails/{filename}
		match /forlob/{forlobId}/thumbnails/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin()
				&& request.resource.size < 3 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
		}

		// Admin-uploads (PDF'er, manualer m.m.)
		match /admin/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin();
		}

		// Fælles opskrift-billeder — Linns egne opskrifter, som alle kunder ser.
		// Adskilt fra /users/{uid}/opskrift-billeder nedenfor, som er kundens
		// EGNE private billeder. Disse er fælles og må læses af alle kunder.
		//
		// Ligger her fordi billederne før lå inde i selve opskrift-dokumentet
		// som tekst. To billeder vejede 189 KB, altså halvdelen af hele
		// opskrift-samlingen, og de blev hentet hver gang listen blev åbnet.
		match /opskrifter/{filename=**} {
			allow read: if request.auth != null;
			allow write: if isAdmin()
				&& request.resource.size < 3 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
		}

		// Billeder af VAREDEKLARATIONER, 24. august 2026. Se HANDOVER 9.51.
		//
		// Beviset bag en scannet vare. Kunden fotograferer tabellen paa
		// pakken, vi laeser tallene af den, og billedet bliver liggende
		// saa alle kan se hvor tallet kommer fra.
		//
		// LAESES AF ALLE, fordi varen deles med alle. Kunne kun hun der
		// tog billedet se det, ville beviset ikke vaere noget bevis.
		//
		// SKRIVES KUN I HENDES EGEN MAPPE. Uid'et staar i stien, saa det
		// altid kan ses hvem der har lagt et billede op, og ingen kan
		// overskrive en andens.
		//
		// 2 MB er rigeligt. Et skaleret billede af en varetabel vejer
		// omkring 40 KB.
		match /deklarationer/{uid}/{filename=**} {
			allow read: if request.auth != null;
			allow write: if request.auth != null
				&& request.auth.uid == uid
				&& request.resource.size < 2 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
			// Linns noedbremse: hun kan fjerne et billede der ikke skal
			// ligge der, ligesom hun kan fjerne selve varen.
			allow delete: if isAdmin();
		}

		// Private opskrift-billeder — klientens egne billeder fra "Min opskrift".
		// Hver bruger kan kun læse + skrive til sin egen mappe. Max 5 MB pr fil.
		match /users/{uid}/opskrift-billeder/{filename=**} {
			allow read: if request.auth != null && request.auth.uid == uid;
			allow write: if request.auth != null
				&& request.auth.uid == uid
				&& request.resource.size < 5 * 1024 * 1024
				&& request.resource.contentType.matches('image/.*');
		}
	}
}
